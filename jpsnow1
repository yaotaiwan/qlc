<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>日本滑雪認證資格</title>
<style>
:root{--s0:#fff;--s1:#f5f4ef;--bd:rgba(0,0,0,.15);--bds:rgba(0,0,0,.3);--tx:#1a1a1a;--t2:#5f5e5a;--t3:#888780;--ac:#185fa5;--acbg:#e6f1fb;--acbd:#85b7eb;--dg:#a32d2d}
@media (prefers-color-scheme:dark){:root{--s0:#262624;--s1:#1f1e1d;--bd:rgba(255,255,255,.15);--bds:rgba(255,255,255,.3);--tx:#f1efe8;--t2:#b4b2a9;--t3:#888780;--ac:#b5d4f4;--acbg:#0c447c;--acbd:#378add;--dg:#f09595}}
*{box-sizing:border-box}
body{margin:0;padding:12px;background:var(--s0);color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,"Noto Sans TC","Hiragino Sans",sans-serif;font-size:16px;line-height:1.5;max-width:480px;margin:0 auto}
button{font:inherit;color:inherit;background:transparent;border:.5px solid var(--bds);border-radius:8px;cursor:pointer;padding:6px 12px}
button:active{transform:scale(.98)}
textarea,input{font:inherit;color:inherit;background:var(--s0);border:.5px solid var(--bds);border-radius:8px;padding:6px 8px;width:100%}
.card{background:var(--s1);border-radius:12px;padding:12px}
.q-tab{flex:1;padding:8px 0;font-size:14px}
.on{background:var(--acbg);color:var(--ac);border-color:var(--acbd)}
.q-grp{width:100%;text-align:left;font-size:14px;font-weight:500;display:flex;justify-content:space-between;align-items:center;margin:0 0 8px}
.q-chips{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 14px}
.q-chip{padding:6px 12px;font-size:13px;border-radius:999px}
.q-lab{font-size:12px;color:var(--t2);display:flex;justify-content:space-between;align-items:center;margin:0 0 4px}
.q-mini{font-size:12px;padding:2px 10px}
#lst{font-family:ui-monospace,Menlo,monospace;font-size:13px;resize:vertical;min-height:52px}
#cde{font-family:ui-monospace,Menlo,monospace;font-size:16px;letter-spacing:2px;text-transform:uppercase}
.desc{background:var(--s0);border:.5px solid var(--bd);border-radius:8px;padding:10px 12px;min-height:64px}
</style>
</head>
<body>
<div class="card">
  <div style="font-size:15px;font-weight:500">日本滑雪認證資格</div>
  <div style="font-size:12px;color:var(--t3);margin:0 0 10px">title placeholder</div>

  <div class="q-lab"><span>List (type, paste or edit)</span>
    <span><button class="q-mini" id="cpl">Copy</button> <button class="q-mini" id="clr">Clear</button></span></div>
  <textarea id="lst" rows="2" placeholder="SAJ1, SAJ2, CSIA3"></textarea>

  <div class="q-lab" style="margin-top:8px"><span>Code (type or paste)</span>
    <span><button class="q-mini" id="cpc">Copy</button></span></div>
  <input id="cde" type="text" autocomplete="off" spellcheck="false">

  <div style="display:flex;justify-content:space-between;font-size:12px;margin:6px 0 12px">
    <span id="msg" style="color:var(--t2)"></span><span id="cnt" style="color:var(--t2)"></span></div>

  <div style="display:flex;gap:8px;margin:0 0 12px">
    <button class="q-tab on" id="t-jp">日本 Japan</button>
    <button class="q-tab" id="t-in">國際 International</button>
  </div>
  <div id="body"></div>
  <div class="desc">
    <div id="dt" style="font-size:13px;font-weight:500;margin:0 0 2px">Description</div>
    <div id="dd" style="font-size:13px;color:var(--t2);line-height:1.5">Tap a group button or an item to see its description.</div>
  </div>
</div>

<script>
var D={
jp:[
{n:'SAJ 級別檢定 1–5',d:'全日本スキー連盟的技術檢定（badge test）。1–5 級是滑雪技術考核，不等於教練資格；5 級最基礎，1 級最高。',items:[
['SAJ5','5 級：プルークボーゲン，緩斜面。'],
['SAJ4','4 級：プルークボーゲン節奏變化，緩斜面。'],
['SAJ3','3 級：基礎平行轉彎＋シュテムボーゲン，緩至中斜面。'],
['SAJ2','2 級：總合滑降，需通過規程檢定。'],
['SAJ1','1 級：需先取得 2 級並上完事前講習。']]},
{n:'SAJ 公認指導者（暫定命名）',d:'SAJ 公認的指導員資格，需養成講習、實技與理論測驗。縮寫是暫擬，待確認。',items:[
['SAJ-SI','公認スキー準指導員（暫擬縮寫）。'],
['SAJ-I','公認スキー指導員（暫擬縮寫）。']]}],
intl:[
{n:'CSIA 加拿大',d:'Canadian Ski Instructors’ Alliance，Level 1–4。',items:[
['CSIA1','CSIA Level 1。'],['CSIA2','CSIA Level 2。'],
['CSIA3','CSIA Level 3，通常對應國際 ISIA 認可。'],['CSIA4','CSIA Level 4，最高級。']]},
{n:'BASI 英國',d:'British Association of Snowsport Instructors，Level 1–4。',items:[
['BASI1','BASI Level 1。'],['BASI2','BASI Level 2。'],
['BASI3','BASI Level 3，附 ISIA。'],['BASI4','BASI Level 4。']]},
{n:'NZSIA 紐西蘭',d:'NZ Snowsports Instructors Alliance，Level 1–3；在日本二世谷、妙高有培訓課程。',items:[
['NZSIA1','NZSIA Level 1，入門。'],['NZSIA2','NZSIA Level 2。'],
['NZSIA3','NZSIA Level 3，可換發 ISIA。']]},
{n:'APSI 澳洲',d:'Australian Professional Snowsports Instructors；近年等級改名，查閱時留意新舊級別。',items:[
['APSI1','APSI Level 1（新制入門）。'],['APSI2','APSI Level 2。'],
['APSI3','APSI Level 3，國際 ISIA 認可。'],['APSI4','APSI Level 4，最高。']]}]};

var ALL=[],cur='jp',sel={},tabs={jp:'t-jp',intl:'t-in'};
['jp','intl'].forEach(function(t){D[t].forEach(function(g){g.items.forEach(function(i){ALL.push(i[0])})})});
var N=ALL.length,L=Math.ceil(N*Math.LN2/Math.log(36));
var $=function(i){return document.getElementById(i)};
var MAP={};ALL.forEach(function(k,i){MAP[k]=i;MAP[k.replace('-','')]=i});

function toCode(){var v=0;ALL.forEach(function(k,i){if(sel[k])v+=Math.pow(2,i)});
  var s=v.toString(36).toUpperCase();while(s.length<L)s='0'+s;return s}
function toList(){return ALL.filter(function(k){return sel[k]})}
function groupOn(g){return g.items.every(function(i){return sel[i[0]]})}
function say(t,d){$('dt').textContent=t;$('dd').textContent=d}
function msg(t,bad){$('msg').textContent=t;$('msg').style.color=bad?'var(--dg)':'var(--t2)'}

function sync(src){
  var l=toList();
  if(src!=='lst')$('lst').value=l.join(', ');
  if(src!=='cde')$('cde').value=toCode();
  $('cnt').textContent=l.length+' / '+N+' selected · '+L+'-char code';
  renderBody();
}
function renderBody(){
  var b=$('body');b.innerHTML='';
  D[cur].forEach(function(g){
    var gb=document.createElement('button');
    gb.className='q-grp'+(groupOn(g)?' on':'');
    gb.innerHTML='<span>'+g.n+'</span><span style="font-size:12px;font-weight:400">'+(groupOn(g)?'clear all':'select all')+'</span>';
    gb.onclick=function(){var on=!groupOn(g);
      g.items.forEach(function(i){if(on)sel[i[0]]=1;else delete sel[i[0]]});
      say(g.n,g.d);msg('');sync()};
    b.appendChild(gb);
    var c=document.createElement('div');c.className='q-chips';
    g.items.forEach(function(i){
      var x=document.createElement('button');
      x.className='q-chip'+(sel[i[0]]?' on':'');x.textContent=i[0];
      x.onclick=function(){if(sel[i[0]])delete sel[i[0]];else sel[i[0]]=1;
        say(i[0],i[1]);msg('');sync()};
      c.appendChild(x)});
    b.appendChild(c)})
}

$('lst').addEventListener('input',function(){
  var toks=this.value.split(/[\s,，、]+/).filter(Boolean),bad=[],ns={};
  toks.forEach(function(t){var k=t.toUpperCase();
    if(MAP[k]===undefined)bad.push(t);else ns[ALL[MAP[k]]]=1});
  sel=ns;msg(bad.length?'Not in list: '+bad.join(', '):'',bad.length);sync('lst')});

$('cde').addEventListener('input',function(){
  var v=this.value.trim().toUpperCase();
  if(!v){sel={};msg('');sync('cde');return}
  if(!/^[0-9A-Z]+$/.test(v)){msg('Use letters A–Z and digits only.',1);return}
  if(v.length!==L){msg('Code should be '+L+' characters.',1);return}
  var n=parseInt(v,36);
  if(n>=Math.pow(2,N)){msg('That code is out of range.',1);return}
  var ns={};ALL.forEach(function(k,i){if(Math.floor(n/Math.pow(2,i))%2===1)ns[k]=1});
  sel=ns;msg('');sync('cde')});

$('clr').onclick=function(){sel={};msg('');sync()};
function cp(id,btn){var el=$(id);el.select();
  try{navigator.clipboard.writeText(el.value);btn.textContent='Copied'}catch(e){btn.textContent='Selected'}
  setTimeout(function(){btn.textContent='Copy'},1200)}
$('cpl').onclick=function(){cp('lst',this)};
$('cpc').onclick=function(){cp('cde',this)};
Object.keys(tabs).forEach(function(k){$(tabs[k]).onclick=function(){
  cur=k;Object.keys(tabs).forEach(function(j){$(tabs[j]).className='q-tab'+(j===k?' on':'')});renderBody()}});
sync();
</script>
</body>
</html>
